{
  "name": "heborn",
  "description": "Web client for Hacker Experience 1",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackerexperience/heborn"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "setup": "tools/install-elm.sh && node tools/elm-deps.js install . && node tools/elm-deps.js install tests",
    "css": "node tools/elm-css.js src/Core/Stylesheets.elm static/css",
    "dev": "npm run css && webpack serve --mode development",
    "build": "npm run css && webpack --mode production",
    "test": "node tools/run-tests.js",
    "lint": "elm-format --elm-version=0.18 --validate src tests"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet-ant-path": "^1.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "elm-format": "^0.8.8",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^6.0.0"
  }
}
